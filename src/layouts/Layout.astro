---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Jasa Bor Pile dan Pancang Malang - Pondasi Mandiri",
  description = "Kontraktor spesialis bore pile hydraulic rig, mini crane, pancang HSPD, dan sedot lumpur terpercaya di Malang dengan armada sendiri."
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="PT. Konstruksi Pondasi Mandiri" />
    <meta name="publisher" content="PT. Konstruksi Pondasi Mandiri" />

    <!-- Google Fonts: Poppins (Urban Mechline Standard) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      :root {
        font-family: 'Poppins', system-ui, -apple-system, sans-serif;
      }
      .font-heading {
        font-family: 'Poppins', system-ui, sans-serif;
      }
      /* Mechline Marquee Animation */
      @keyframes ticker {
        0% { transform: translate3d(0, 0, 0); }
        100% { transform: translate3d(-50%, 0, 0); }
      }
      .animate-ticker {
        animation: ticker 28s linear infinite;
      }
      .animate-ticker:hover {
        animation-play-state: paused;
      }
    </style>
  </head>
  <body class="bg-white text-mechline-dark antialiased selection:bg-mechline-blue selection:text-white overflow-x-hidden font-sans">
    <slot />
  </body>
</html>
