---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('artikel');
  return articles.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Get other articles for recommendation
const allArticles = await getCollection('artikel');
const otherArticles = allArticles
  .filter((item) => item.slug !== entry.slug)
  .slice(0, 3);

const canonicalUrl = `https://borpile.vercel.app/artikel/${entry.slug}/`;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": entry.data.title,
  "description": entry.data.description,
  "image": `https://borpile.vercel.app${entry.data.heroImage}`,
  "datePublished": entry.data.publishDate,
  "author": {
    "@type": "Organization",
    "name": entry.data.author,
    "url": "https://borpile.vercel.app/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "PT. Konstruksi Pondasi Mandiri",
    "logo": {
      "@type": "ImageObject",
      "url": "https://borpile.vercel.app/favicon.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
};
---

<Layout
  title={`${entry.data.seoTitle || entry.data.title}`}
  description={entry.data.description}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />

  <Header />

  <main class="min-h-screen bg-white py-10 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-neutral-500 mb-6 font-medium">
        <a href="/" class="hover:text-mechline-blue transition-colors">Beranda</a>
        <span>/</span>
        <a href="/artikel/" class="hover:text-mechline-blue transition-colors">Artikel & Panduan</a>
        <span>/</span>
        <span class="text-mechline-dark truncate max-w-xs">{entry.data.category}</span>
      </nav>

      <!-- Article Header -->
      <header class="mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-mechline-blue/10 text-mechline-blue text-xs font-bold uppercase tracking-wider mb-4">
          {entry.data.category}
        </div>
        <h1 class="font-heading text-2xl sm:text-4xl lg:text-5xl font-extrabold text-mechline-dark tracking-tight leading-tight mb-4">
          {entry.data.title}
        </h1>
        <div class="flex flex-wrap items-center gap-3 text-xs text-neutral-500 border-y border-neutral-200 py-3">
          <span>Ditulis oleh: <strong class="text-mechline-dark font-semibold">{entry.data.author}</strong></span>
          <span>•</span>
          <time datetime={entry.data.publishDate}>Dipublikasikan: {entry.data.publishDate}</time>
          <span>•</span>
          <span class="text-emerald-700 font-semibold">📍 Area: Malang Raya</span>
        </div>
      </header>

      <!-- Featured Image -->
      <div class="aspect-video w-full rounded-2xl overflow-hidden bg-neutral-100 border border-neutral-200 mb-10 shadow-xs">
        <img
          src={entry.data.heroImage}
          alt={`Dokumentasi lapangan ${entry.data.title}`}
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>

      <!-- Markdown Prose Content -->
      <article class="prose prose-neutral max-w-none prose-headings:font-heading prose-headings:font-bold prose-headings:text-mechline-dark prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-10 prose-h2:mb-4 prose-h3:text-lg sm:prose-h3:text-xl prose-h3:mt-6 prose-h3:mb-2 prose-p:text-neutral-700 prose-p:leading-relaxed prose-p:text-sm sm:prose-p:text-base prose-li:text-neutral-700 prose-li:text-sm sm:prose-li:text-base prose-table:text-xs sm:prose-table:text-sm prose-th:bg-neutral-100 prose-th:p-3 prose-td:p-3 prose-td:border prose-th:border prose-strong:text-mechline-dark">
        <Content />
      </article>

      <!-- Article Taxonomical Tags (Anti-Overspace, Clean Inline Typographic) -->
      <div class="mt-8 pt-4 border-t border-neutral-200 text-xs text-neutral-600 flex flex-wrap items-center gap-x-2 gap-y-1">
        <span class="font-bold text-neutral-800 uppercase tracking-wider">Tag:</span>
        {entry.data.tags.map((tag) => (
          <span class="text-neutral-600 hover:text-mechline-blue hover:underline underline-offset-4 transition-colors">
            #{tag}
          </span>
        ))}
      </div>

      <!-- Author Box & Single End-of-Article WhatsApp CTA -->
      <div class="mt-12 p-6 sm:p-8 rounded-2xl bg-mechline-surface border border-neutral-200/90 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xs">
        <div class="space-y-1 text-center sm:text-left">
          <div class="text-xs text-neutral-500 font-medium uppercase tracking-wider">Konsultasi Rekayasa Pondasi</div>
          <h3 class="font-heading font-bold text-lg text-mechline-dark">Punya Rencana Proyek Bor Pile di Malang?</h3>
          <p class="text-xs text-neutral-600 max-w-md">
            Konsultasikan hasil sondir tanah, kedalaman tiang, dan ketersediaan armada langsung bersama tim teknik Pondasi Mandiri.
          </p>
        </div>
        <a
          href={`https://wa.me/6285183005070?text=${encodeURIComponent(`Halo Estimator Pondasi Mandiri, saya membaca artikel "${entry.data.title}" dan ingin konsultasi kebutuhan bor pile untuk proyek saya di Malang.`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 px-6 py-3 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs sm:text-sm tracking-wide shadow-sm transition-all flex items-center gap-2"
        >
          <span>Chat WhatsApp: 0851-8300-5070</span>
          <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.54 1.767.828 2.796.828h.005c3.181 0 5.767-2.587 5.768-5.766 0-3.18-2.586-5.766-5.768-5.766zm9.969 5.766c0 5.514-4.486 10-10 10-1.708 0-3.32-.43-4.743-1.189l-5.257 1.378 1.4-5.118c-.85-1.488-1.341-3.21-1.341-5.043 0-5.514 4.486-10 10-10s10 4.486 10 10z"/>
          </svg>
        </a>
      </div>

      <!-- Related Articles Section -->
      {otherArticles.length > 0 && (
        <section class="mt-16 pt-12 border-t border-neutral-200">
          <h3 class="font-heading font-bold text-xl text-mechline-dark mb-6">
            Panduan Teknik Lainnya
          </h3>
          <div class="grid sm:grid-cols-3 gap-6">
            {otherArticles.map((rel) => (
              <a href={`/artikel/${rel.slug}/`} class="group block space-y-2">
                <div class="aspect-video rounded-xl overflow-hidden bg-neutral-100 border border-neutral-200">
                  <img
                    src={rel.data.heroImage}
                    alt={`Ilustrasi ${rel.data.title}`}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
                <div class="text-[10px] text-mechline-blue font-bold uppercase tracking-wider">
                  {rel.data.category}
                </div>
                <h4 class="text-xs font-bold text-mechline-dark group-hover:text-mechline-blue transition-colors line-clamp-2 leading-snug">
                  {rel.data.title}
                </h4>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </main>

  <Footer />
</Layout>
