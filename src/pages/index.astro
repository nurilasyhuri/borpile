---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import SpotlightMachine from '../components/SpotlightMachine.astro';
import Projects from '../components/Projects.astro';
import DifferenceSlider from '../components/DifferenceSlider.astro';
import TrustStrip from '../components/TrustStrip.astro';
import StoreLocations from '../components/StoreLocations.astro';
import Calculator from '../components/Calculator.astro';
import ConsultationGallery from '../components/ConsultationGallery.astro';
import ArticleSection from '../components/ArticleSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Jasa Bor Pile dan Tiang Pancang Terpercaya Indonesia - Borpile Nusantara"
  description="Kontraktor spesialis jasa bore pile hydraulic rig, mini crane, pancang HSPD, dan sedot lumpur terpercaya di seluruh Indonesia dengan armada sendiri."
>
  <Header />
  <main>
    <Hero />
    <Services />
    <SpotlightMachine />
    <Projects />
    <DifferenceSlider />
    <TrustStrip />
    <StoreLocations />
    <Calculator />
    <ConsultationGallery />
    <ArticleSection />
  </main>
  <Footer />
</Layout>
