---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SpotlightMachine from '../components/SpotlightMachine.astro';
import EquipmentBadges from '../components/EquipmentBadges.astro';
import DifferenceSlider from '../components/DifferenceSlider.astro';
import TrustStrip from '../components/TrustStrip.astro';
import Services from '../components/Services.astro';
import StoreLocations from '../components/StoreLocations.astro';
import Calculator from '../components/Calculator.astro';
import SapWorkflow from '../components/SapWorkflow.astro';
import TechnicalSafety from '../components/TechnicalSafety.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Jasa Bor Pile dan Pancang Malang - Pondasi Mandiri"
  description="Kontraktor spesialis bore pile hydraulic rig, mini crane, pancang HSPD, dan sedot lumpur terpercaya di Malang dengan armada sendiri."
>
  <Header />
  <main>
    <Hero />
    <SpotlightMachine />
    <EquipmentBadges />
    <DifferenceSlider />
    <TrustStrip />
    <Services />
    <StoreLocations />
    <Calculator />
    <SapWorkflow />
    <TechnicalSafety />
  </main>
  <Footer />
</Layout>
