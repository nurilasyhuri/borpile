---
const faqs = [
  {
    q: "Kapan memilih Bore Pile dan kapan memilih Piling HSPD (Pancang Tekan)?",
    a: "Bore Pile (Wash Boring / Dry Boring) dipilih jika tanah keras berada di lapisan dalam (hingga 30-45 meter), diameter tiang besar (30-120 cm), atau terdapat bebatuan cadas yang tidak bisa ditembus tiang pancang. Sedangkan Piling HSPD (Hydraulic Static Pile Driver) ideal dipilih untuk kawasan perumahan padat dengan target tiang 20x20 atau 25x25 cm, di mana owner menginginkan proses cepat tanpa kebisingan dan 0% getaran."
  },
  {
    q: "Bagaimana cara kerja dan legalitas pembuangan layanan Sedot Lumpur?",
    a: "Pada metode bor pile basah (wash boring), lumpur sirkulasi ditampung sementara dalam bak sedimentasi (mud pit). Armada truk tangki vacuum kami menyedot lumpur kental tersebut secara tertutup dan mengangkutnya ke tempat pembuangan akhir (disposal area) resmi yang telah berizin, menjamin selokan warga dan jalan umum bebas dari ceceran limbah lumpur."
  },
  {
    q: "Apa kelebihan Bore Pile Mini Hydraulic (Metode Kering) dibanding metode basah?",
    a: "Metode kering (dry boring auger) tidak membutuhkan pasokan air kerja dan tidak menghasilkan limbah lumpur cair sama sekali. Metode ini sangat disukai oleh manajemen proyek industri aktif, rumah sakit, area perkantoran, dan fasilitas umum yang menerapkan regulasi kebersihan dan keselamatan (K3) ketat."
  },
  {
    q: "Berapa kapasitas diameter dan kedalaman unit Hydraulic Drilling Rig?",
    a: "Unit Hydraulic Drilling Rig kelas berat kami (seperti XCMG XR 150 DIII) mampu mengerjakan lubang bor berdiameter 50 cm hingga 120 cm (bahkan hingga 150 cm untuk pondasi khusus) dengan jangkauan kedalaman Kelly bar hingga 45 meter, sangat tangguh untuk struktur gedung tinggi, jembatan, dan tiang pancang tiang baja."
  },
  {
    q: "Apakah dijamin aman dari risiko tembok tetangga retak?",
    a: "Dijamin 100% aman. Baik metode putar bore pile (hydraulic rig & mini crane) maupun tekan hidrolik statis HSPD bekerja tanpa pukulan hammer dinamis. Karena tidak ada energi kejut yang merambat ke tanah sekelilingnya, struktur dinding bangunan tetangga di samping lokasi proyek tidak akan mengalami getaran atau retakan."
  },
  {
    q: "Bagaimana mekanisme pengukuran kedalaman dan penagihan biaya di lapangan?",
    a: "Sistem penagihan kami transparan berbasis opname kedalaman riil. Setiap kali lubang bor selesai dibuat, perwakilan kontraktor/owner bersama mandor kami mengukur kedalaman aktual menggunakan pita ukur dan mencatatnya dalam Berita Acara Harian. Anda hanya membayar volume meter lari nyata yang dikerjakan."
  }
];
---

<section id="faq" class="py-16 md:py-24 bg-white border-b border-mechline-border text-mechline-dark">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-14">
      <div class="text-xs font-semibold text-mechline-blue uppercase tracking-wider mb-2">
        Tanya Jawab Teknis
      </div>
      <h2 class="font-heading text-2xl sm:text-4xl font-extrabold text-mechline-dark tracking-tight mb-3">
        Pertanyaan Umum Seputar Pondasi & Operasional
      </h2>
      <p class="text-mechline-gray text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        Klarifikasi atas pertanyaan teknis, legalitas pembuangan lumpur, dan prosedur keselamatan yang sering diajukan oleh kontraktor maupun pemilik proyek.
      </p>
    </div>

    <!-- Accordion / FAQ List -->
    <div class="space-y-3.5">
      {faqs.map((f) => (
        <details class="group rounded-xl bg-mechline-surface border border-neutral-200/90 p-5 sm:p-6 [&_summary::-webkit-details-marker]:hidden transition-all duration-200 open:border-mechline-blue open:bg-white shadow-xs">
          <summary class="flex items-center justify-between cursor-pointer list-none gap-4">
            <span class="font-heading text-sm sm:text-base font-bold text-mechline-dark group-hover:text-mechline-blue transition-colors">
              {f.q}
            </span>
            <span class="shrink-0 w-7 h-7 rounded-full bg-white border border-neutral-200 flex items-center justify-center text-neutral-600 group-open:rotate-180 group-open:bg-mechline-blue group-open:text-white transition-all duration-300">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="mt-3.5 pt-3.5 border-t border-neutral-200/80 text-xs sm:text-sm text-mechline-gray leading-relaxed">
            {f.a}
          </div>
        </details>
      ))}
    </div>

  </div>
</section>
