---
import { getCollection } from 'astro:content';

const allArticles = await getCollection('artikel');
const featuredArticles = allArticles.slice(0, 3);
---

<section id="artikel" class="py-16 md:py-24 bg-white border-b border-mechline-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
      <div>
        <h2 class="font-heading text-2xl sm:text-4xl font-extrabold text-mechline-dark tracking-tight mb-2">
          Artikel & Panduan Teknik Pondasi
        </h2>
        <p class="text-sm sm:text-base text-mechline-gray max-w-2xl">
          Edukasi teknis mengenai pemilihan metode tiang pancang, prosedur wash boring, mitigasi getaran pemukiman, dan analisis data sondir tanah di Malang.
        </p>
      </div>

      <a
        href="/artikel/"
        class="text-xs font-semibold text-mechline-blue hover:text-mechline-blue-hover uppercase tracking-wider inline-flex items-center gap-1.5 shrink-0 self-start sm:self-auto"
      >
        <span>Lihat Semua 7 Panduan Teknis</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14m-7-7 7 7-7 7"/>
        </svg>
      </a>
    </div>

    <!-- 3-Column Card Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredArticles.map((item) => (
        <article class="bg-white rounded-xl border border-neutral-200/90 overflow-hidden shadow-xs hover:shadow-md transition flex flex-col justify-between group">
          <div>
            <a href={`/artikel/${item.slug}/`} class="block aspect-video overflow-hidden bg-neutral-100 relative">
              <img
                src={item.data.heroImage}
                alt={`Ilustrasi ${item.data.title}`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded bg-black/75 backdrop-blur-xs text-white text-[9px] font-bold uppercase tracking-wider">
                {item.data.category}
              </span>
            </a>

            <div class="p-5">
              <div class="text-[11px] text-neutral-400 font-medium mb-1.5">
                <time datetime={item.data.publishDate}>{item.data.publishDate}</time>
              </div>

              <h3 class="font-heading text-base font-bold text-mechline-dark group-hover:text-mechline-blue transition-colors leading-snug mb-2">
                <a href={`/artikel/${item.slug}/`}>
                  {item.data.title}
                </a>
              </h3>

              <p class="text-xs text-neutral-600 leading-relaxed line-clamp-2 mb-3">
                {item.data.description}
              </p>

              <div class="text-[10px] text-neutral-400 flex flex-wrap gap-x-1.5">
                {item.data.tags.slice(0, 2).map((tag) => (
                  <span>#{tag}</span>
                ))}
              </div>
            </div>
          </div>

          <div class="px-5 py-3 bg-neutral-50 border-t border-neutral-100">
            <a
              href={`/artikel/${item.slug}/`}
              class="inline-flex items-center gap-1 text-xs font-semibold text-mechline-blue hover:text-mechline-blue-hover transition"
            >
              <span>Pelajari Detail Teknis</span>
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M5 12h14m-7-7 7 7-7 7"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
