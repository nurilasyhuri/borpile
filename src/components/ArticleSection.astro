---
import { getCollection } from 'astro:content';

const allArticles = await getCollection('artikel');

function parseArticleDate(str: string): number {
  if (!str) return 0;
  const iso = Date.parse(str);
  if (!isNaN(iso)) return iso;
  const idMonths: Record<string, number> = {
    januari: 0, februari: 1, maret: 2, april: 3, mei: 4, juni: 5,
    juli: 6, agustus: 7, september: 8, oktober: 9, november: 10, desember: 11
  };
  const parts = str.trim().split(/\s+/);
  if (parts.length === 3) {
    const day = parseInt(parts[0], 10);
    const month = idMonths[parts[1].toLowerCase()];
    const year = parseInt(parts[2], 10);
    if (!isNaN(day) && month !== undefined && !isNaN(year)) {
      return new Date(year, month, day).getTime();
    }
  }
  return 0;
}

const sortedArticles = [...allArticles].sort(
  (a, b) => parseArticleDate(b.data.publishDate) - parseArticleDate(a.data.publishDate)
);
const featuredArticles = sortedArticles.slice(0, 3);
---

<section id="artikel" class="py-16 md:py-24 bg-white border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading (Clean Without Eyebrow Tag) -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
      <div>
        <h2 class="font-heading text-2xl sm:text-4xl font-extrabold text-slate-950 tracking-normal">
          Artikel & Panduan Teknik Pondasi
        </h2>
        <p class="text-sm sm:text-base text-slate-600 max-w-2xl mt-2 leading-relaxed">
          Edukasi teknis mengenai pemilihan metode tiang pancang, prosedur wash boring, mitigasi getaran pemukiman, dan analisis data geoteknik tanah untuk konstruksi pondasi dalam.
        </p>
      </div>

      <a
        href="/artikel/"
        class="text-xs font-semibold text-slate-800 hover:text-orange-700 uppercase tracking-wider inline-flex items-center gap-1.5 shrink-0 self-start sm:self-auto transition-colors"
      >
        <span>Lihat Semua {allArticles.length} Panduan Teknis</span>
        <svg class="w-3.5 h-3.5 text-orange-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14m-7-7 7 7-7 7"/>
        </svg>
      </a>
    </div>

    <!-- 3-Column Card Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredArticles.map((item) => (
        <article class="bg-white rounded-2xl border border-slate-200/90 overflow-hidden shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between group">
          <div>
            <div class="block aspect-video overflow-hidden bg-slate-100 relative">
              <img
                src={item.data.heroImage}
                alt={`Ilustrasi ${item.data.title}`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 ease-out"
                loading="lazy"
              />
              <div class="absolute top-2.5 left-2.5">
                <span class="px-2.5 py-1 rounded bg-slate-950/80 backdrop-blur-xs text-white text-xs font-semibold uppercase tracking-wider">
                  {item.data.category}
                </span>
              </div>
            </div>

            <div class="p-5">
              <div class="text-xs text-slate-600 font-medium mb-1.5">
                <time datetime={item.data.publishDate}>{item.data.publishDate}</time>
              </div>

              <h3 class="font-heading text-base font-bold text-slate-950 group-hover:text-orange-700 transition-colors leading-snug mb-2">
                <a href={`/artikel/${item.slug}/`}>
                  {item.data.title}
                </a>
              </h3>

              <p class="text-xs text-slate-600 leading-relaxed line-clamp-2 mb-3">
                {item.data.description}
              </p>

              <div class="text-xs text-slate-600 flex flex-wrap gap-x-1.5">
                {item.data.tags.slice(0, 2).map((tag) => (
                  <span>#{tag}</span>
                ))}
              </div>
            </div>
          </div>

          <div class="px-5 py-3 bg-slate-50 border-t border-slate-100">
            <a
              href={`/artikel/${item.slug}/`}
              class="inline-flex items-center gap-1 text-xs font-semibold text-slate-800 hover:text-orange-700 transition-colors"
            >
              <span>Pelajari Detail Teknis</span>
              <svg class="w-3 h-3 text-orange-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M5 12h14m-7-7 7 7-7 7"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
