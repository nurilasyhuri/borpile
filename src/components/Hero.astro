---
---

<section class="relative w-full min-h-[480px] lg:min-h-[620px] bg-slate-950 text-white overflow-hidden flex flex-col justify-between py-10 sm:py-16 lg:py-20" aria-label="Pondasi Mandiri Hero Showcase">
  <!-- Background Image with MSC Scaffolding Gradient Overlay -->
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div class="absolute inset-0 opacity-100 z-10">
      <img
        src="/images/hero-bg.webp"
        alt="Jasa Bor Pile & Tiang Pancang Indonesia — Pondasi Dalam Presisi Bebas Getaran"
        class="w-full h-full object-cover object-center filter brightness-[0.42] contrast-[1.15]"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950/80 via-slate-950/50 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-slate-950/40"></div>
    </div>
  </div>

  <!-- Hero Content Body -->
  <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full h-full flex flex-col justify-between pt-10 sm:pt-14 pb-4">
    
    <div class="max-w-3xl space-y-3 sm:space-y-4 my-auto py-3 sm:py-4">
      
      <!-- Main Headline -->
      <div class="space-y-2">
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold text-white tracking-normal leading-[1.14]">
          Jasa Bor Pile & Pondasi Dalam Presisi Bebas Getaran
        </h1>
      </div>

      <!-- Concise Subtitle Value Proposition -->
      <p class="text-sm sm:text-base lg:text-lg text-slate-300 leading-relaxed font-normal max-w-2xl">
        Kontraktor spesialis bore pile hydraulic rig, mini crane, dry auger, dan tiang pancang tekan (HSPD) bebas getaran dengan armada mandiri untuk proyek di seluruh Indonesia.
      </p>

      <!-- Primary Action CTA & Quick Navigation (Produk, Layanan, Kalkulator, Kontak) -->
      <div class="pt-2 space-y-3">
        <div>
          <a
            href="#kontak"
            class="inline-flex items-center gap-2 px-8 py-3.5 sm:px-9 sm:py-4 rounded-lg bg-orange-700 hover:bg-orange-600 active:scale-95 text-white font-semibold text-sm sm:text-base shadow-lg shadow-orange-950/40 transition-colors"
          >
            <span>Konsultasi Sekarang</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold uppercase tracking-wider text-slate-300">
          <span class="text-slate-300 font-normal">Akses Cepat:</span>
          <a href="#produk" class="text-slate-200 hover:text-orange-400 transition-colors py-1">Produk</a>
          <span class="text-slate-600" aria-hidden="true">•</span>
          <a href="#layanan" class="text-slate-200 hover:text-orange-400 transition-colors py-1">Layanan</a>
          <span class="text-slate-600" aria-hidden="true">•</span>
          <a href="#kalkulator" class="text-slate-200 hover:text-orange-400 transition-colors py-1">Kalkulator</a>
          <span class="text-slate-600" aria-hidden="true">•</span>
          <a href="#kontak" class="text-slate-200 hover:text-orange-400 transition-colors py-1">Kontak</a>
        </div>
      </div>

    </div>

    <!-- 4 Industrial Metric Bottom Strip (MSC Scaffolding Pattern) -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 pt-6 border-t border-slate-800/80 text-left">
      <div class="space-y-0.5">
        <div class="text-2xl sm:text-3xl font-bold text-white tracking-normal font-heading">
          0 <span class="text-xs sm:text-sm font-normal text-slate-400">Kasus</span>
        </div>
        <div class="text-xs text-slate-400 font-medium">
          Retak Dinding Tetangga
        </div>
      </div>

      <div class="space-y-0.5">
        <div class="text-2xl sm:text-3xl font-bold text-white tracking-normal font-heading">
          30–120 <span class="text-xs sm:text-sm font-normal text-slate-400">cm</span>
        </div>
        <div class="text-xs text-slate-400 font-medium">
          Diameter Tiang Bor
        </div>
      </div>

      <div class="space-y-0.5">
        <div class="text-2xl sm:text-3xl font-bold text-white tracking-normal font-heading">
          100% <span class="text-xs sm:text-sm font-normal text-slate-400">Milik Sendiri</span>
        </div>
        <div class="text-xs text-slate-400 font-medium">
          Armada Rig & Vacuum Pool Sendiri
        </div>
      </div>

      <div class="space-y-0.5">
        <div class="text-2xl sm:text-3xl font-bold text-white tracking-normal font-heading">
          Free <span class="text-xs sm:text-sm font-normal text-slate-400">Survei</span>
        </div>
        <div class="text-xs text-slate-400 font-medium">
          Konsultasi & Evaluasi Data Tanah
        </div>
      </div>
    </div>

  </div>
</section>
