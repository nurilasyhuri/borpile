---
---

<section class="relative min-h-[580px] lg:min-h-[640px] flex items-center justify-center bg-black overflow-hidden">
  <!-- Background Image with Industrial Contrast Gradient Overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero-bg.webp"
      alt="Alat berat hydraulic drilling rig proyek pondasi bore pile Malang"
      class="w-full h-full object-cover object-center filter brightness-[0.42] contrast-[1.15]"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/60"></div>
  </div>

  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    
    <!-- Mechline Pill Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-white text-xs font-medium mb-6">
      <span>SPESIALIS REKAYASA PONDASI DALAM & SEDOT LUMPUR KHUSUS WILAYAH MALANG</span>
    </div>

    <!-- Main Headline (Mechline style - No colored spans inside h1) -->
    <h1 class="font-heading text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.12] mb-6">
      Jasa Bor Pile Malang: Pondasi Dalam & Pancang Tekan Presisi
    </h1>

    <p class="text-base sm:text-lg text-neutral-200 max-w-3xl mx-auto mb-10 leading-relaxed font-normal">
      Kontraktor spesialis jasa bore pile mini crane, hydraulic rotary rig, dry auger system, dan tiang pancang tekan HSPD bebas getaran. Dilengkapi armada truk tangki sedot lumpur mandiri bergaransi resmi untuk wilayah Malang Raya.
    </p>

    <!-- Dual Action Pill Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
      <a
        href="https://wa.me/6285183005070?text=Halo%20Pondasi%20Mandiri,%20saya%20ingin%20konsultasi%20layanan%20bor%20pile%20untuk%20proyek%20di%20Malang"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-mechline-blue hover:bg-mechline-blue-hover text-white text-sm font-medium tracking-wide shadow-md transition-all text-center flex items-center justify-center gap-2"
      >
        <span>KONSULTASI WA 0851-8300-5070</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
      <a
        href="#kalkulator"
        class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-white hover:bg-neutral-100 text-mechline-dark border border-neutral-200 text-sm font-medium tracking-wide shadow-xs transition-all text-center"
      >
        SIMULASI KEBUTUHAN TIANG
      </a>
    </div>

    <!-- Quick Fact Points Bar -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-8 border-t border-white/15 text-left text-xs text-neutral-300">
      <div class="flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span>Armada Milik Sendiri (No Calo)</span>
      </div>
      <div class="flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span>0 Kasus Retak Tembok Tetangga</span>
      </div>
      <div class="flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span>Workshop di Malang</span>
      </div>
      <div class="flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span>Free Survei & Analisis SPT</span>
      </div>
    </div>

  </div>
</section>
