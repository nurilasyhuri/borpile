---
const sapSteps = [
  {
    step: "01",
    phase: "Tahap Persiapan",
    title: "Verifikasi Teknis & Analisis Data Sondir",
    desc: "Mempelajari laporan penyelidikan tanah (Sondir/CPT & N-SPT) dari konsultan struktur untuk menentukan diameter tiang, elevasi tanah keras, dan estimasi beban dukung pondasi."
  },
  {
    step: "02",
    phase: "Tahap Lapangan",
    title: "Survei Akses Masuk & Jalur Sirkulasi",
    desc: "Pengecekan langsung ke lokasi proyek: lebar jalan masuk armada rig, jalur pembuangan lumpur tangki vacuum, sumber air kerja, dan inventarisasi kondisi dinding bangunan tetangga."
  },
  {
    step: "03",
    phase: "Tahap Kontrak",
    title: "Penerbitan RAB Definitif & Penandatanganan SPK",
    desc: "Penyusunan rincian anggaran biaya transparan per meter lari atau borongan all-in, jadwal kerja terikat, dan klausul jaminan kualitas tanpa biaya siluman di tengah pekerjaan."
  },
  {
    step: "04",
    phase: "Tahap Pengeboran",
    title: "Mobilisasi Alat, Setting Rig & Pemasangan Casing",
    desc: "Armada tiba di lapangan tepat jadwal. Pengeboran dilakukan secara tegak lurus dengan pemantauan kelurusan, didukung pemasangan casing baja sementara untuk mencegah dinding tanah labil longsor."
  },
  {
    step: "05",
    phase: "Tahap Konstruksi",
    title: "Pemasangan Besi Tulangan & Pengecoran Tremi",
    desc: "Penurunan sangkar besi tulangan terangkai presisi, dilanjutkan pengecoran kontinyu sistem pipa tremi langsung dari dasar tiang bor agar mutu beton padat sempurna tanpa rongga."
  },
  {
    step: "06",
    phase: "Tahap Penyelesaian",
    title: "Penyedotan Lumpur, Opname Bersama & BAST",
    desc: "Lumpur sirkulasi disedot tuntas menggunakan armada truk vacuum tertutup. Pengukuran kedalaman dan volume aktual disaksikan tim pengawas untuk serah terima Berita Acara resmi."
  }
];
---

<section id="panduan" class="py-16 md:py-24 bg-white border-b border-mechline-border text-mechline-dark relative">
  <span id="sap" class="absolute -top-24"></span>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading (No colored spans inside h2) -->
    <div class="max-w-3xl mb-14">
      <div class="text-xs font-semibold text-mechline-blue uppercase tracking-wider mb-2">
        Standar Alur Pelaksanaan (SAP & SOP)
      </div>
      <h2 class="font-heading text-2xl sm:text-4xl font-extrabold text-mechline-dark tracking-tight mb-3">
        Alur Kerja Sistematis dari Survei hingga BAST
      </h2>
      <p class="text-mechline-gray text-sm sm:text-base leading-relaxed">
        Pondasi adalah penopang utama bangunan seumur hidup. Seluruh tahapan kami eksekusi dengan ketelitian teknis, dokumentasi opname riil, dan kepatuhan penuh terhadap standar keselamatan kerja.
      </p>
    </div>

    <!-- 6-Step Workflow Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sapSteps.map((s) => (
        <div class="p-6 rounded-xl bg-mechline-surface border border-neutral-200/90 flex flex-col justify-between hover:border-black hover:bg-neutral-50 transition-all duration-200 group">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-heading font-extrabold text-lg text-mechline-dark group-hover:text-mechline-blue transition-colors">
                {s.step}
              </span>
              <span class="text-[11px] font-semibold text-neutral-600 bg-white px-2.5 py-1 rounded border border-neutral-200">
                {s.phase}
              </span>
            </div>

            <h3 class="font-heading font-bold text-base text-mechline-dark group-hover:text-mechline-blue transition-colors mb-2 leading-snug">
              {s.title}
            </h3>

            <p class="text-xs text-mechline-gray leading-relaxed">
              {s.desc}
            </p>
          </div>

          <div class="pt-4 mt-4 border-t border-neutral-200/80 flex items-center justify-between text-[11px] text-neutral-400">
            <span>SOP Standar K3</span>
            <span class="text-emerald-600 font-semibold">Tervalidasi ✓</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
