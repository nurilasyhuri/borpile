---
---

<section id="spotlight" class="py-16 md:py-24 bg-white border-b border-mechline-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Machinery Stage & Angles -->
      <div class="lg:col-span-6 flex flex-col items-center">
        <!-- Main Machine Stage -->
        <div class="w-full aspect-square max-w-[520px] rounded-2xl bg-mechline-surface border border-neutral-200/80 p-6 flex items-center justify-center relative overflow-hidden shadow-xs">
          <!-- Machine Badge -->
          <div class="absolute top-4 left-4 z-10">
            <span class="inline-block px-3 py-1 text-[11px] font-semibold uppercase tracking-wider bg-black text-white rounded-md">
              Flagship Fleet Malang
            </span>
          </div>

          <!-- Dynamic Machine Image -->
          <img
            id="spotlight-img"
            src="/images/machine-rig.webp"
            alt="Armada Hydraulic Bore Pile Rig dan Mini Crane Pondasi Mandiri Malang"
            class="w-full h-full object-cover rounded-xl transition-all duration-300 transform hover:scale-105"
          />
        </div>

        <!-- Thumbnail Gallery -->
        <div class="grid grid-cols-4 gap-3 mt-4 w-full max-w-[520px]">
          <button
            type="button"
            class="spotlight-thumb active aspect-square rounded-lg bg-mechline-surface border-2 border-mechline-dark p-1 overflow-hidden"
            data-src="/images/machine-rig.webp"
            aria-label="Tampilan Alat Berat Hydraulic Rig"
          >
            <img src="/images/machine-rig.webp" alt="Alat Berat Hydraulic Rig" class="w-full h-full object-cover rounded" />
          </button>
          <button
            type="button"
            class="spotlight-thumb aspect-square rounded-lg bg-mechline-surface border border-neutral-200 p-1 overflow-hidden opacity-70 hover:opacity-100 transition"
            data-src="/images/machine-minicrane.webp"
            aria-label="Pengecekan Presisi Pipa Tremi"
          >
            <img src="/images/machine-minicrane.webp" alt="Pengecekan Presisi Pipa Tremi" class="w-full h-full object-cover rounded" />
          </button>
          <button
            type="button"
            class="spotlight-thumb aspect-square rounded-lg bg-mechline-surface border border-neutral-200 p-1 overflow-hidden opacity-70 hover:opacity-100 transition"
            data-src="/images/field-3.webp"
            aria-label="Tim Engineering Lapangan K3"
          >
            <img src="/images/field-3.webp" alt="Tim Engineering Lapangan K3" class="w-full h-full object-cover rounded" />
          </button>
          <button
            type="button"
            class="spotlight-thumb aspect-square rounded-lg bg-mechline-surface border border-neutral-200 p-1 overflow-hidden opacity-70 hover:opacity-100 transition"
            data-src="/images/field-1.webp"
            aria-label="Pondasi Tiang Beton Selesai Cor"
          >
            <img src="/images/field-1.webp" alt="Pondasi Tiang Beton Selesai Cor" class="w-full h-full object-cover rounded" />
          </button>
        </div>
      </div>

      <!-- Right Column: Interactive Machine Spec Sheet & Quick Configurator (NO PRICES) -->
      <div class="lg:col-span-6 space-y-6">
        
        <!-- Header Metadata -->
        <div>
          <div class="flex items-center gap-2 text-xs text-mechline-gray mb-1.5 font-medium">
            <span>Pondasi Mandiri Fleet</span>
            <span>•</span>
            <div class="flex items-center gap-1">
              <svg class="w-4 h-4 text-[#d97706]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.12 2.12 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.12 2.12 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.12 2.12 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.12 2.12 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.12 2.12 0 0 0 1.597-1.16z"/>
              </svg>
              <span class="font-bold text-mechline-dark">Standar K3</span>
              <span class="text-neutral-500">(Unit Sendiri di Malang)</span>
            </div>
          </div>

          <h2 class="font-heading text-2xl sm:text-3xl font-extrabold text-mechline-dark tracking-tight">
            Hydraulic Drilling Rig & Mini Crane Bore Pile
          </h2>
        </div>

        <!-- Badges Pill Row -->
        <div class="flex flex-wrap items-center gap-2 text-xs">
          <span class="px-3 py-1 rounded-md bg-neutral-900 text-white font-medium">Unit Milik Sendiri (No Calo)</span>
          <span class="px-3 py-1 rounded-md bg-neutral-100 text-neutral-800 border border-neutral-300 font-medium">Garansi Tembus SPT Keras</span>
          <span class="px-3 py-1 rounded-md bg-neutral-100 text-neutral-800 border border-neutral-300 font-medium">Pool: Kedungkandang, Malang</span>
        </div>

        <!-- Machine Availability (Zero Price) -->
        <div class="border-y border-mechline-border py-3">
          <div class="text-xs text-mechline-gray font-medium">Kesiapan Armada & Status Operasional:</div>
          <div class="flex items-baseline gap-2 mt-0.5">
            <span class="font-heading text-xl sm:text-2xl font-bold text-emerald-600">
              Ready Mobilisasi Cepat
            </span>
            <span class="text-xs text-mechline-gray font-normal">/ Siap mobilisasi ke seluruh wilayah Malang</span>
          </div>
          <p class="text-[11px] text-neutral-500 mt-1">
            *Penawaran resmi disesuaikan dengan volume titik, kedalaman tanah keras (SPT), dan lokasi proyek Anda.
          </p>
        </div>

        <!-- Option Selectors -->
        <div class="space-y-4 text-xs">
          
          <!-- 1. Diameter Tiang -->
          <div>
            <div class="font-medium text-mechline-dark mb-2">Pilih Diameter Tiang Bor:</div>
            <div class="flex flex-wrap gap-2" id="spotlight-dia-options">
              <button type="button" data-dia="30" class="dia-pill px-3.5 py-1.5 rounded-md border border-neutral-200 bg-white hover:border-black font-medium transition">30 cm</button>
              <button type="button" data-dia="40" class="dia-pill active px-3.5 py-1.5 rounded-md border-2 border-black bg-black text-white font-semibold transition">40 cm</button>
              <button type="button" data-dia="50" class="dia-pill px-3.5 py-1.5 rounded-md border border-neutral-200 bg-white hover:border-black font-medium transition">50 cm</button>
              <button type="button" data-dia="60" class="dia-pill px-3.5 py-1.5 rounded-md border border-neutral-200 bg-white hover:border-black font-medium transition">60 cm</button>
              <button type="button" data-dia="80" class="dia-pill px-3.5 py-1.5 rounded-md border border-neutral-200 bg-white hover:border-black font-medium transition">80 cm</button>
            </div>
          </div>

          <!-- 2. Sistem / Metode Mesin -->
          <div>
            <div class="font-medium text-mechline-dark mb-2">Pilih Tipe Mesin & Metode:</div>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" id="spotlight-method-options">
              <button type="button" data-method="wash" class="method-card active p-2.5 rounded-lg border-2 border-black bg-neutral-50 text-left transition">
                <div class="font-bold text-xs text-mechline-dark">Wash Boring</div>
                <div class="text-[10px] text-neutral-500">Mini Crane / Basah</div>
              </button>
              <button type="button" data-method="dry" class="method-card p-2.5 rounded-lg border border-neutral-200 bg-white text-left hover:border-neutral-400 transition">
                <div class="font-bold text-xs text-mechline-dark">Mini Hydraulic</div>
                <div class="text-[10px] text-neutral-500">Metode Kering Auger</div>
              </button>
              <button type="button" data-method="rig" class="method-card p-2.5 rounded-lg border border-neutral-200 bg-white text-left hover:border-neutral-400 transition">
                <div class="font-bold text-xs text-mechline-dark">Hydraulic Rig</div>
                <div class="text-[10px] text-neutral-500">Heavy Duty XCMG/Sany</div>
              </button>
            </div>
          </div>

          <!-- 3. Quantity Counters: Titik & Kedalaman -->
          <div class="grid grid-cols-2 gap-4 pt-2">
            <div>
              <span class="block font-medium text-mechline-dark mb-1.5">Jumlah Titik Bor:</span>
              <div class="flex items-center border border-neutral-300 rounded-lg overflow-hidden w-full max-w-[160px] bg-white">
                <button type="button" id="btn-points-dec" class="w-10 h-9 flex items-center justify-center text-neutral-600 hover:bg-neutral-100 font-bold transition">−</button>
                <input type="number" id="input-points" value="12" min="1" max="500" class="w-full text-center font-bold text-mechline-dark focus:outline-none" />
                <button type="button" id="btn-points-inc" class="w-10 h-9 flex items-center justify-center text-neutral-600 hover:bg-neutral-100 font-bold transition">+</button>
              </div>
            </div>

            <div>
              <span class="block font-medium text-mechline-dark mb-1.5">Kedalaman Rata-rata:</span>
              <div class="flex items-center border border-neutral-300 rounded-lg overflow-hidden w-full max-w-[160px] bg-white">
                <button type="button" id="btn-depth-dec" class="w-10 h-9 flex items-center justify-center text-neutral-600 hover:bg-neutral-100 font-bold transition">−</button>
                <input type="number" id="input-depth" value="15" min="4" max="50" class="w-full text-center font-bold text-mechline-dark focus:outline-none" />
                <button type="button" id="btn-depth-inc" class="w-10 h-9 flex items-center justify-center text-neutral-600 hover:bg-neutral-100 font-bold transition">+</button>
              </div>
            </div>
          </div>

          <!-- Volume Summary Bar (NO PRICE SHOWN) -->
          <div class="p-3.5 rounded-xl bg-mechline-surface border border-neutral-200 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <span class="text-[11px] text-mechline-gray block">Estimasi Total Volume Kerja:</span>
              <span id="spotlight-volume-display" class="font-bold text-mechline-dark text-sm">180 Meter Lari (12 titik × 15m)</span>
            </div>
            <div class="sm:text-right">
              <span class="text-[11px] text-mechline-gray block">Konsultasi & Penawaran RAB:</span>
              <span class="font-heading font-bold text-sm text-mechline-blue">
                Hubungi WA 0851-8300-5070
              </span>
            </div>
          </div>

        </div>

        <!-- Action Buttons (Direct WhatsApp) -->
        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <a
            id="spotlight-wa-btn"
            href="https://wa.me/6285183005070?text=Halo%20Pondasi%20Mandiri,%20saya%20ingin%20konsultasi%20spesifikasi%20bor%20pile%20diameter%2040cm%20volume%20180m"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 py-3 px-6 rounded-full bg-mechline-blue hover:bg-mechline-blue-hover text-white text-xs font-semibold text-center uppercase tracking-wider transition shadow-xs flex items-center justify-center gap-2"
          >
            <span>Konsultasi WA 0851-8300-5070</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="#sap"
            class="py-3 px-6 rounded-full bg-mechline-dark hover:bg-black text-white text-xs font-semibold text-center uppercase tracking-wider transition"
          >
            Pelajari Alur Kerja Lapangan
          </a>
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  let selectedDia = '40';
  let points = 12;
  let depth = 15;

  const volumeDisplay = document.getElementById('spotlight-volume-display');
  const inputPoints = document.getElementById('input-points') as HTMLInputElement | null;
  const inputDepth = document.getElementById('input-depth') as HTMLInputElement | null;
  const waBtn = document.getElementById('spotlight-wa-btn') as HTMLAnchorElement | null;

  function updateTotals() {
    const totalVolume = points * depth;
    if (volumeDisplay) volumeDisplay.textContent = `${totalVolume} Meter Lari (${points} titik × ${depth}m)`;
    if (waBtn) {
      const msg = `Halo Pondasi Mandiri, saya ingin konsultasi spesifikasi bor pile diameter ${selectedDia} cm, kedalaman ${depth} meter, jumlah ${points} titik (Total: ${totalVolume} m').`;
      waBtn.href = `https://wa.me/6285183005070?text=${encodeURIComponent(msg)}`;
    }
  }

  // Diameter pills
  const diaPills = document.querySelectorAll('.dia-pill');
  diaPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      diaPills.forEach((p) => {
        p.classList.remove('active', 'border-2', 'border-black', 'bg-black', 'text-white', 'font-semibold');
        p.classList.add('border', 'border-neutral-200', 'bg-white', 'font-medium');
      });
      pill.classList.remove('border', 'border-neutral-200', 'bg-white', 'font-medium');
      pill.classList.add('active', 'border-2', 'border-black', 'bg-black', 'text-white', 'font-semibold');

      selectedDia = pill.getAttribute('data-dia') || '40';
      updateTotals();
    });
  });

  // Method cards
  const methodCards = document.querySelectorAll('.method-card');
  methodCards.forEach((card) => {
    card.addEventListener('click', () => {
      methodCards.forEach((c) => {
        c.classList.remove('active', 'border-2', 'border-black', 'bg-neutral-50');
        c.classList.add('border', 'border-neutral-200', 'bg-white');
      });
      card.classList.remove('border', 'border-neutral-200', 'bg-white');
      card.classList.add('active', 'border-2', 'border-black', 'bg-neutral-50');
    });
  });

  // Quantity dec/inc
  document.getElementById('btn-points-dec')?.addEventListener('click', () => {
    if (points > 1) {
      points--;
      if (inputPoints) inputPoints.value = points.toString();
      updateTotals();
    }
  });
  document.getElementById('btn-points-inc')?.addEventListener('click', () => {
    points++;
    if (inputPoints) inputPoints.value = points.toString();
    updateTotals();
  });
  inputPoints?.addEventListener('change', (e) => {
    points = Math.max(1, parseInt((e.target as HTMLInputElement).value || '1', 10));
    updateTotals();
  });

  document.getElementById('btn-depth-dec')?.addEventListener('click', () => {
    if (depth > 4) {
      depth--;
      if (inputDepth) inputDepth.value = depth.toString();
      updateTotals();
    }
  });
  document.getElementById('btn-depth-inc')?.addEventListener('click', () => {
    depth++;
    if (inputDepth) inputDepth.value = depth.toString();
    updateTotals();
  });
  inputDepth?.addEventListener('change', (e) => {
    depth = Math.max(4, parseInt((e.target as HTMLInputElement).value || '4', 10));
    updateTotals();
  });

  // Thumbnail switcher
  const mainImg = document.getElementById('spotlight-img') as HTMLImageElement | null;
  const thumbs = document.querySelectorAll('.spotlight-thumb');
  thumbs.forEach((thumb) => {
    thumb.addEventListener('click', () => {
      thumbs.forEach((t) => {
        t.classList.remove('active', 'border-2', 'border-mechline-dark');
        t.classList.add('border', 'border-neutral-200', 'opacity-70');
      });
      thumb.classList.remove('border', 'border-neutral-200', 'opacity-70');
      thumb.classList.add('active', 'border-2', 'border-mechline-dark', 'opacity-100');
      const newSrc = thumb.getAttribute('data-src');
      if (mainImg && newSrc) {
        mainImg.src = newSrc;
      }
    });
  });
</script>
