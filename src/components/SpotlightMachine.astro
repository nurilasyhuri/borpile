---
const fleet = [
  {
    title: "Hydraulic Rotary Drilling Rig",
    category: "Heavy Duty Bore Pile",
    specs: "Diameter 50 s.d 120 cm · Kedalaman s.d 40 meter",
    desc: "Armada bor pile torsi tinggi untuk pondasi gedung bertingkat, abutment jembatan, dan tiang jembatan jalan layang.",
    img: "/images/machine-rig.webp",
    swatches: ["50cm", "60cm", "80cm", "100cm", "120cm"],
    readiness: "Siap Mobilisasi"
  },
  {
    title: "Wash Boring Mini Crane",
    category: "Proyek Akses Sempit & Hunian",
    specs: "Diameter 30 s.d 80 cm · Kedalaman s.d 30 meter",
    desc: "Rig tiang bor fleksibel yang mampu bermanuver di jalan perumahan sempit lebar 3 meter tanpa merusak fasilitas sekitar.",
    img: "/images/machine-minicrane.webp",
    swatches: ["30cm", "40cm", "50cm", "60cm", "80cm"],
    readiness: "Siap Mobilisasi"
  },
  {
    title: "Mini Hydraulic Dry Auger System",
    category: "Metode Kering Bebas Lumpur",
    specs: "Diameter 35 s.d 100 cm · Kedalaman s.d 24 meter",
    desc: "Pengeboran kering rotary auger langsung tanpa sirkulasi air, ideal untuk area basement, pabrik beroperasi, dan rumah sakit.",
    img: "/images/machine-minihydraulic.webp",
    swatches: ["35cm", "40cm", "50cm", "60cm", "80cm"],
    readiness: "Siap Mobilisasi"
  },
  {
    title: "Silent Jacking Pile (HSPD)",
    category: "Tiang Pancang Tekan Hidrolik",
    specs: "Kapasitas 80 s.d 320 Ton · Tiang 20x20 s.d 40x40",
    desc: "Mesin pancang tekan statis tanpa suara benturan hammer dan 0% getaran, menjamin dinding tetangga tidak retak.",
    img: "/images/machine-hspd.webp",
    swatches: ["20x20", "25x25", "30x30", "40x40", "Dia 30"],
    readiness: "Siap Mobilisasi"
  }
];
---

<section id="produk" class="py-20 sm:py-24 bg-slate-50 border-b border-slate-200/80 scroll-mt-16">
  <div id="armada" class="sr-only"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Clean Without Eyebrow Tag) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="max-w-2xl">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-950 tracking-normal">
          Armada Heavy-Duty & Spesifikasi Alat
        </h2>
      </div>

      <a
        href="#kalkulator"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-slate-300 hover:border-orange-500 hover:text-orange-700 text-xs font-semibold text-slate-800 transition-colors bg-white shadow-2xs self-start md:self-auto"
      >
        <span>Hitung Kebutuhan Tiang</span>
        <svg class="w-3.5 h-3.5 text-orange-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>

    <!-- 4-Column Clean Product Card Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {fleet.map((item) => (
        <div class="group bg-white rounded-2xl border border-slate-200/90 p-4 hover:border-slate-300 hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <!-- Image Stage -->
            <div class="relative w-full aspect-square rounded-xl overflow-hidden mb-4 bg-slate-100 flex items-center justify-center">
              <img
                src={item.img}
                alt={item.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 ease-out"
                loading="lazy"
              />
              <div class="absolute top-2.5 left-2.5">
                <span class="px-2 py-0.5 rounded bg-slate-950/80 backdrop-blur-xs text-white text-xs font-semibold uppercase tracking-wider">
                  {item.readiness}
                </span>
              </div>
            </div>

            <!-- Diameter Swatches -->
            <div class="flex flex-wrap gap-1 mb-3">
              {item.swatches.map((sw) => (
                <span class="px-2 py-0.5 text-xs font-medium bg-slate-100 text-slate-700 rounded border border-slate-200">
                  {sw}
                </span>
              ))}
            </div>

            <!-- Content Details -->
            <div class="space-y-1">
              <h3 class="font-heading font-bold text-sm text-slate-950 group-hover:text-orange-700 transition-colors leading-snug">
                {item.title}
              </h3>
              <p class="text-xs font-medium text-orange-700">
                {item.specs}
              </p>
              <p class="text-xs text-slate-600 leading-relaxed pt-1 line-clamp-3">
                {item.desc}
              </p>
            </div>
          </div>

          <!-- Bottom Text Action -->
          <div class="pt-4 mt-3 border-t border-slate-100">
            <a
              href="#kontak"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-800 hover:text-orange-700 transition-colors group-hover:translate-x-0.5 duration-200"
            >
              <span>Konsultasi Spesifikasi</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
