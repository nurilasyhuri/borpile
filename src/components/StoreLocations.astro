---
const locations = [
  {
    name: "Kantor & Workshop Pusat Malang",
    area: "Puncak Buring Indah, Kedungkandang",
    address: "Puncak Buring Indah, Kel. Buring, Kec. Kedungkandang, Kota Malang 65136",
    coverage: "Pusat koordinasi teknik, konsultasi struktur, analisis SPT/Sondir, & survei proyek area Malang.",
    phone: "0851-8300-5070",
    email: "kontak@pondasimandiri.com",
    img: "/images/pool-narogong.webp"
  },
  {
    name: "Pool Alat Berat & Hydraulic Rig",
    area: "Kedungkandang, Kota Malang",
    address: "Kawasan Workshop Buring, Kec. Kedungkandang, Kota Malang",
    coverage: "Pangkalan standby rig hydraulic bor pile, mini crane, unit pancang HSPD, & mesin genset heavy-duty.",
    phone: "0851-8300-5070",
    email: "kontak@pondasimandiri.com",
    img: "/images/pool-bsd.webp"
  },
  {
    name: "Depo Truk Vacuum & Fabrikasi Tulangan",
    area: "Kedungkandang, Kota Malang",
    address: "Area Logistik Terpadu Buring, Kec. Kedungkandang, Kota Malang",
    coverage: "Armada truk tangki vacuum sedot lumpur, fabrikasi keranjang besi spiral, pipa tremi cor, & mata bor auger.",
    phone: "0851-8300-5070",
    email: "kontak@pondasimandiri.com",
    img: "/images/pool-bogor.webp"
  }
];
---

<section id="kontak" class="py-16 md:py-24 bg-mechline-surface border-b border-mechline-border relative">
  <span id="depo" class="absolute -top-24"></span>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Title -->
    <div class="mb-12">
      <h2 class="font-heading text-2xl sm:text-4xl font-extrabold text-mechline-dark tracking-tight mb-2">
        Workshop & Base Operasional Malang
      </h2>
      <p class="text-sm sm:text-base text-mechline-gray max-w-2xl">
        Seluruh unit alat berat, workshop rekayasa fabrikasi, dan armada truk tangki vacuum berpusat di Puncak Buring Indah, Kedungkandang, Kota Malang untuk melayani proyek di wilayah Malang.
      </p>
    </div>

    <!-- 3-Column Card Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {locations.map((loc) => (
        <div class="bg-white rounded-xl border border-neutral-200/90 overflow-hidden shadow-xs flex flex-col justify-between hover:shadow-md transition">
          <div class="p-6 space-y-4">
            
            <div class="flex items-center gap-4">
              <div class="w-20 h-20 rounded-lg overflow-hidden bg-neutral-100 shrink-0 border border-neutral-200">
                <img src={loc.img} alt={loc.name} class="w-full h-full object-cover" />
              </div>
              <div>
                <h3 class="font-heading font-bold text-base text-mechline-dark">
                  {loc.name}
                </h3>
                <span class="text-xs text-mechline-blue font-medium block">
                  {loc.area}
                </span>
              </div>
            </div>

            <div class="space-y-2 text-xs text-mechline-gray border-t border-neutral-150 pt-3">
              <div>
                <span class="font-semibold text-mechline-dark block mb-0.5">Alamat:</span>
                <p class="text-neutral-600 leading-relaxed">{loc.address}</p>
              </div>

              <div>
                <span class="font-semibold text-mechline-dark block mb-0.5">Fasilitas & Layanan:</span>
                <p class="text-neutral-600 leading-relaxed">{loc.coverage}</p>
              </div>

              <div class="pt-1">
                <span class="font-semibold text-mechline-dark block mb-0.5">Kontak WhatsApp:</span>
                <p class="text-neutral-600 font-bold text-emerald-600">WhatsApp: {loc.phone}</p>
              </div>
            </div>

          </div>

          <div class="p-4 bg-neutral-50 border-t border-neutral-200/80">
            <a
              href={`https://wa.me/6285183005070?text=${encodeURIComponent('Halo Pondasi Mandiri, saya ingin konsultasi kebutuhan mobilisasi alat bor pile untuk proyek di Malang')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full py-2 text-center text-xs font-semibold text-mechline-dark hover:text-mechline-blue transition"
            >
              Hubungi via WhatsApp: 0851-8300-5070 →
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
