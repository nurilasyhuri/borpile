---
const locations = [
  {
    name: "Workshop Pusat & Pool Staging Rig",
    area: "Pusat Operasional Alat Berat",
    address: "Kompleks Pool Rig & Workshop Fabrikasi Tulangan Besi Mandiri",
    coverage: "Staging armada hydraulic rig, mini crane, pembuatan rangkaian besi tulangan, dan bengkel bubut matabor.",
    phone: "0851-8300-5070",
    img: "/images/pool-bogor.webp"
  },
  {
    name: "Stasiun Truk Tangki Vacuum Lumpur",
    area: "Armada Lingkungan & Sanitasi K3",
    address: "Depo Armada Khusus & Staging Truk Tangki Vacuum",
    coverage: "Pangkalan truk tangki vacuum 4.000–6.000 liter untuk penanganan sedot lumpur & limbah bor pile berizin resmi.",
    phone: "0851-8300-5070",
    img: "/images/machine-vacuum.webp"
  }
];
---

<section id="depo" class="py-20 sm:py-24 bg-white border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Clean Without Eyebrow Tag) -->
    <div class="max-w-2xl mb-12">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-950 tracking-normal">
        Workshop & Pool Fasilitas Alat Berat
      </h2>
    </div>

    <!-- 2-Column Physical Facility Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
      {locations.map((loc) => (
        <div class="group flex flex-col justify-between space-y-4">
          <div>
            <div class="relative w-full aspect-[16/10] rounded-2xl overflow-hidden mb-4 bg-slate-100">
              <img
                src={loc.img}
                alt={loc.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 ease-out"
                loading="lazy"
              />
              <div class="absolute top-4 left-4">
                <span class="px-3 py-1 rounded-md bg-slate-950/80 backdrop-blur-xs text-white text-xs font-semibold uppercase tracking-wider">
                  {loc.area}
                </span>
              </div>
            </div>

            <h3 class="text-lg sm:text-xl font-bold text-slate-950">
              {loc.name}
            </h3>

            <div class="space-y-2 text-xs text-slate-600 mt-3 pt-3 border-t border-slate-100">
              <div>
                <span class="font-semibold text-slate-900 block mb-0.5">Alamat Operasional:</span>
                <p class="leading-relaxed">{loc.address}</p>
              </div>

              <div>
                <span class="font-semibold text-slate-900 block mb-0.5">Fasilitas & Kapasitas:</span>
                <p class="leading-relaxed">{loc.coverage}</p>
              </div>
            </div>
          </div>

          <div class="pt-2">
            <a
              href="#kontak"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-800 hover:text-orange-700 transition-colors group-hover:translate-x-0.5 duration-200"
            >
              <span>Koordinasi Mobilisasi & Kunjungan Pool</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
