---
const services = [
  {
    title: "Bore Pile Mini Crane & Rotary Rig",
    category: "Pondasi Gedung & Akses Sempit",
    desc: "Pengeboran tiang bor basah (wash boring) dan kering (dry auger) diameter 30 s.d 120 cm untuk proyek ruko, jembatan, dan gedung bertingkat.",
    img: "/images/machine-minicrane.webp",
    href: "#armada",
    tag: "Paling Populer"
  },
  {
    title: "Silent Jacking Pile (HSPD)",
    category: "Pancang Bebas Getaran",
    desc: "Metode tiang pancang tekan hidrolik statis tanpa suara dentuman hammer dan 0% getaran, aman untuk proyek di pemukiman padat.",
    img: "/images/machine-hspd.webp",
    href: "#armada",
    tag: "Bebas Retak"
  },
  {
    title: "Truk Tangki Vacuum Sedot Lumpur",
    category: "Sanitasi & K3 Lingkungan",
    desc: "Armada truk tangki sedot lumpur mandiri berkapasitas 4.000 liter untuk penanganan limbah galian bor pile agar proyek tetap bersih dan tertib.",
    img: "/images/machine-vacuum.webp",
    href: "#armada",
    tag: "Armada Sendiri"
  }
];

const steps = [
  {
    num: "01",
    title: "Konsultasi & Data Tanah",
    desc: "Evaluasi data sondir (SPT) & estimasi kebutuhan titik tiang via WhatsApp."
  },
  {
    num: "02",
    title: "Survei & Penawaran SPH",
    desc: "Survei akses lapangan dan penerbitan estimasi penawaran SPH resmi terperinci."
  },
  {
    num: "03",
    title: "Mobilisasi Alat & Rig",
    desc: "Pengiriman alat berat langsung dari pool workshop ke lokasi proyek Anda."
  },
  {
    num: "04",
    title: "Eksekusi Presisi & K3",
    desc: "Pengeboran standar SNI, opname riil, dan pembuangan lumpur tangki berizin."
  }
];
---

<section id="layanan" class="py-20 sm:py-24 bg-white border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Clean Without Eyebrow Tag) -->
    <div class="max-w-2xl mb-12">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-950 tracking-normal">
        Layanan Rekayasa Pondasi Dalam
      </h2>
    </div>

    <!-- 3 Core Service Showcase Cards (Aspect 4/3 with Circle Arrow Pill) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {services.map((item) => (
        <a class="group block" href={item.href}>
          <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden mb-4 bg-slate-100">
            <img
              src={item.img}
              alt={item.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 ease-out"
              loading="lazy"
            />
            <div class="absolute top-3.5 left-3.5">
              <span class="px-2.5 py-1 rounded-md bg-slate-950/80 backdrop-blur-xs text-white text-xs font-semibold uppercase tracking-wider">
                {item.tag}
              </span>
            </div>
          </div>

          <div class="space-y-1.5">
            <div class="flex items-center justify-between pt-1">
              <h3 class="text-base sm:text-lg font-bold text-slate-950 group-hover:text-orange-700 transition-colors">
                {item.title}
              </h3>
              <div class="w-8 h-8 rounded-full bg-slate-100 group-hover:bg-orange-700 flex items-center justify-center text-slate-600 group-hover:text-white transition-colors shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </div>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
              {item.desc}
            </p>
          </div>
        </a>
      ))}
    </div>

    <!-- Alur Layanan (Clean Process Strip) -->
    <div class="mt-20 pt-16 border-t border-slate-100">
      <div class="max-w-2xl mb-8">
        <h3 class="text-xl sm:text-2xl font-bold text-slate-950 tracking-normal">
          Alur Layanan Pondasi Mandiri
        </h3>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        {steps.map((st) => (
          <div class="p-5 sm:p-6 rounded-2xl bg-slate-50 border border-slate-100 hover:border-slate-200 transition-colors space-y-2 sm:space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xl sm:text-2xl font-black text-orange-700 font-heading">
                {st.num}
              </span>
              <div class="w-8 h-8 rounded-full bg-white border border-slate-200 flex items-center justify-center text-orange-700 shadow-2xs">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
            </div>
            <div>
              <h4 class="text-xs sm:text-sm font-bold text-slate-950">
                {st.title}
              </h4>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                {st.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
