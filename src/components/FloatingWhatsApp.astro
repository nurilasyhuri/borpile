---
const waNumber = "6281288887766";
---

<div class="fixed bottom-6 right-6 z-50 flex items-center gap-3">
  <!-- Tooltip/Badge -->
  <a
    href={`https://wa.me/${waNumber}?text=Halo%20Admin%20Borpile%20Indonesia,%20saya%20mau%20konsultasi%20kebutuhan%20pondasi%20borpile.`}
    target="_blank"
    rel="noopener noreferrer"
    class="hidden sm:flex items-center gap-2 bg-slate-900/95 backdrop-blur-md text-white text-xs font-semibold py-2.5 px-4 rounded-full border border-emerald-500/40 shadow-xl hover:border-emerald-500 transition-all group"
  >
    <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
    <span class="text-slate-200 group-hover:text-emerald-400 transition-colors">Chat CS / Fast Respon 24 Jam</span>
  </a>

  <!-- Floating WA Button -->
