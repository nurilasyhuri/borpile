    href={`https://wa.me/${waNumber}?text=Halo%20Admin%20Borpile%20Indonesia,%20saya%20mau%20konsultasi%20kebutuhan%20pondasi%20borpile.`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat WhatsApp Admin Borpile"
    class="relative w-14 h-14 rounded-full bg-emerald-500 hover:bg-emerald-400 text-white flex items-center justify-center shadow-2xl shadow-emerald-500/40 hover:scale-110 active:scale-95 transition-all group"
  >
