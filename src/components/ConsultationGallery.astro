---
---

<section class="py-16 md:py-20 bg-white border-b border-mechline-border text-mechline-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-10 items-center">
      
      <!-- Left Column: Consultation Inquiry Box (Mechline Newsletter Card) -->
      <div class="lg:col-span-5 bg-mechline-surface border border-neutral-200/90 rounded-2xl p-7 sm:p-9 shadow-xs">
        <div class="w-10 h-10 rounded-xl bg-white border border-neutral-200 flex items-center justify-center text-mechline-dark mb-5">
          <svg class="w-5 h-5 text-mechline-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>

        <h3 class="font-heading font-extrabold text-xl sm:text-2xl text-mechline-dark mb-2">
          Jadwalkan Survei & Diskusi Teknis
        </h3>
        <p class="text-xs sm:text-sm text-mechline-gray leading-relaxed mb-6">
          Dapatkan evaluasi awal gambar struktur proyek, analisis kedalaman tanah keras SPT, dan penawaran RAB resmi tanpa komitmen.
        </p>

        <form action="#kalkulator" class="space-y-3">
          <div class="relative">
            <input
              type="text"
              placeholder="Kebutuhan Anda / Lokasi Proyek..."
              class="w-full bg-white border border-neutral-300 rounded-lg px-4 py-3 text-xs sm:text-sm text-mechline-dark focus:outline-none focus:border-mechline-blue transition pr-12"
            />
            <a
              href="#kalkulator"
              class="absolute right-2 top-2 bottom-2 px-3.5 bg-mechline-dark hover:bg-black text-white rounded-md flex items-center justify-center transition"
              aria-label="Lanjutkan ke Kalkulator"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
          <p class="text-[11px] text-neutral-400">
            *Respon cepat dari tim estimator kami dalam 1x24 jam kerja.
          </p>
        </form>
      </div>

      <!-- Right Column: 3 Field Photos (Mechline Social Grid Format) -->
      <div class="lg:col-span-7">
        <div class="flex items-center justify-between mb-4">
          <span class="font-heading font-bold text-base text-mechline-dark">
            Dokumentasi Lapangan Real-Time
          </span>
          <span class="text-xs text-mechline-gray font-medium">
            Jabodetabek & Jawa Barat
          </span>
        </div>

        <div class="grid grid-cols-3 gap-3 sm:gap-4">
          <div class="aspect-[3/4] rounded-xl overflow-hidden bg-neutral-100 border border-neutral-200 group">
            <img
              src="/images/field-1.webp"
              alt="Pengeboran Bore Pile Mini Crane Lapangan"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
          </div>
          <div class="aspect-[3/4] rounded-xl overflow-hidden bg-neutral-100 border border-neutral-200 group">
            <img
              src="/images/field-2.webp"
              alt="Setting Hydraulic Rig di Kawasan Industri"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
          </div>
          <div class="aspect-[3/4] rounded-xl overflow-hidden bg-neutral-100 border border-neutral-200 group">
            <img
              src="/images/field-3.webp"
              alt="Opname Pengukuran Kedalaman Tanah Bersama Pengawas"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
