---
const projects = [
  {
    title: "Pondasi Gedung & Pengecoran Tremi",
    location: "Proyek Gedung Bertingkat",
    desc: "Pemasangan sangkar tulangan baja dan pengecoran continue pipa tremi untuk struktur gedung bertingkat.",
    img: "/images/field-1.webp",
    badge: "Bore Pile Gedung"
  },
  {
    title: "Bore Pile Akses Jalan Sempit",
    location: "Proyek Ruko Perkotaan",
    desc: "Pengeboran tiang bor di gang padat selebar 3 meter diapit dinding bangunan ruko eksisting tanpa getaran.",
    img: "/images/field-2.webp",
    badge: "Mini Crane Sempit"
  },
  {
    title: "Pondasi Kawasan Industri & Gudang",
    location: "Proyek Pergudangan Logistik",
    desc: "Pekerjaan pondasi tiang bor grid presisi tinggi untuk lantai bentang lebar beban berat pergudangan industri.",
    img: "/images/field-3.webp",
    badge: "Kawasan Industri"
  }
];
---

<section id="proyek" class="py-20 sm:py-24 bg-white border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Clean Without Eyebrow Tag) -->
    <div class="max-w-2xl mb-12">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-950 tracking-normal">
        Dokumentasi Proyek Lapangan
      </h2>
    </div>

    <!-- 3-Column Image Cards (Aspect 16/10) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((item) => (
        <div class="group relative aspect-[16/10] rounded-2xl overflow-hidden bg-slate-950 shadow-xs">
          <img
            src={item.img}
            alt={item.title}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 ease-out"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/40 to-transparent"></div>
          
          <div class="absolute top-4 left-4">
            <span class="px-2.5 py-1 rounded-md bg-black/60 backdrop-blur-xs text-white text-xs font-semibold uppercase tracking-wider border border-white/10">
              {item.badge}
            </span>
          </div>

          <div class="absolute bottom-4 left-4 right-4 text-white">
            <span class="text-xs text-orange-400 font-semibold block mb-0.5">
              {item.location}
            </span>
            <h3 class="font-heading font-bold text-base text-white leading-snug">
              {item.title}
            </h3>
            <p class="text-xs text-slate-300 mt-1 line-clamp-2 leading-relaxed">
              {item.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
