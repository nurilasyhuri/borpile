---
const projects = [
  {
    title: "Pondasi Gedung & Ruko Komersial 5 Lantai",
    location: "Pantai Indah Kapuk (PIK), Jakarta Utara",
    dia: "Diameter 40 cm & 50 cm",
    depth: "Kedalaman 18 Meter",
    points: "48 Titik Pengeboran",
    machine: "Wash Boring Mini Crane",
    category: "Ruko & Komersial",
    badge: "Opname 100%",
    img: "/images/field-1.webp"
  },
  {
    title: "Pondasi Abutment Jembatan & Flyover",
    location: "Kawasan Industri KIIC, Karawang",
    dia: "Diameter 100 cm (1 Meter)",
    depth: "Kedalaman 38 Meter",
    points: "32 Titik Pengeboran",
    machine: "Hydraulic Drilling Rig",
    category: "Infrastruktur",
    badge: "Uji PDA Lulus",
    img: "/images/machine-rig.webp"
  },
  {
    title: "Pondasi Bangunan Produksi Farmasi (Clean Site)",
    location: "Cikarang Industrial Estate, Bekasi",
    dia: "Diameter 60 cm",
    depth: "Kedalaman 15 Meter",
    points: "26 Titik Pengeboran",
    machine: "Mini Hydraulic Dry System",
    category: "Pabrik / Kering",
    badge: "Bebas Lumpur",
    img: "/images/machine-minihydraulic.webp"
  },
  {
    title: "Pancang Perumahan Dekat Dinding Tetangga",
    location: "BSD City, Tangerang Selatan",
    dia: "Tiang Kotak 25x25 cm",
    depth: "Kedalaman 12 Meter",
    points: "36 Titik Pemancangan",
    machine: "Piling HSPD (Tekan 120 Ton)",
    category: "Silent Jacking Pile",
    badge: "Zero Getaran",
    img: "/images/machine-hspd.webp"
  },
  {
    title: "Pondasi Hunian Mewah Kontur Tebing",
    location: "Sentul City, Bogor, Jawa Barat",
    dia: "Diameter 50 cm",
    depth: "Kedalaman 14 Meter",
    points: "24 Titik Pengeboran",
    machine: "Wash Boring + Truk Sedot Lumpur",
    category: "Residensial Mewah",
    badge: "Site Bersih",
    img: "/images/machine-tremie.webp"
  },
  {
    title: "Pondasi Menara Telekomunikasi BTS",
    location: "Tanjungsari, Sumedang, Jawa Barat",
    dia: "Diameter 50 cm",
    depth: "Kedalaman 12 Meter",
    points: "16 Titik Pengeboran",
    machine: "Wash Boring Modular",
    category: "Infrastruktur Tower",
    badge: "SPT Keras",
    img: "/images/field-3.webp"
  }
];
---

<section id="portofolio" class="py-16 md:py-24 bg-mechline-surface border-b border-mechline-border text-mechline-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Heading (No colored spans inside h2) -->
    <div class="max-w-3xl mb-14">
      <div class="text-xs font-semibold text-mechline-blue uppercase tracking-wider mb-2">
        Portofolio & Bukti Opname Lapangan
      </div>
      <h2 class="font-heading text-2xl sm:text-4xl font-extrabold text-mechline-dark tracking-tight mb-3">
        Dokumentasi Proyek Pondasi di Jabodetabek & Jawa Barat
      </h2>
      <p class="text-mechline-gray text-sm sm:text-base leading-relaxed">
        Rekam jejak pengerjaan pondasi tiang bor dan tiang pancang tekan statis pada beragam sektor industri, infrastruktur, ruko komersial, dan hunian bertingkat.
      </p>
    </div>

    <!-- 3-Column Project Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((p) => (
        <div class="bg-white rounded-xl border border-neutral-200/90 overflow-hidden flex flex-col justify-between hover:shadow-md transition-all duration-200 group">
          <div>
            <div class="aspect-[16/10] bg-neutral-100 overflow-hidden relative">
              <img
                src={p.img}
                alt={p.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <div class="absolute top-3 left-3">
                <span class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider bg-black/80 backdrop-blur-xs text-white rounded">
                  {p.category}
                </span>
              </div>
              <div class="absolute top-3 right-3">
                <span class="px-2.5 py-1 text-[10px] font-bold bg-white text-emerald-700 rounded border border-emerald-200 shadow-xs">
                  {p.badge}
                </span>
              </div>
            </div>

            <div class="p-5 space-y-3">
              <h3 class="font-heading font-bold text-base text-mechline-dark group-hover:text-mechline-blue transition-colors leading-snug">
                {p.title}
              </h3>
              
              <div class="flex items-center gap-1.5 text-xs text-neutral-500">
                <svg class="w-3.5 h-3.5 text-neutral-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>{p.location}</span>
              </div>

              <div class="grid grid-cols-2 gap-2 pt-2 border-t border-neutral-150 text-xs text-mechline-dark">
                <div>
                  <span class="text-[10px] text-neutral-400 block">Spesifikasi:</span>
                  <span class="font-semibold">{p.dia}</span>
                </div>
                <div>
                  <span class="text-[10px] text-neutral-400 block">Kedalaman:</span>
                  <span class="font-semibold">{p.depth}</span>
                </div>
                <div>
                  <span class="text-[10px] text-neutral-400 block">Volume:</span>
                  <span class="font-semibold">{p.points}</span>
                </div>
                <div>
                  <span class="text-[10px] text-neutral-400 block">Armada:</span>
                  <span class="font-semibold text-neutral-700">{p.machine}</span>
                </div>
              </div>
            </div>
          </div>

          <div class="p-4 bg-neutral-50 border-t border-neutral-150 flex items-center justify-between text-xs">
            <span class="text-neutral-500">Hasil Tes Struktur:</span>
            <span class="font-semibold text-mechline-dark">Memenuhi SNI ✓</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
