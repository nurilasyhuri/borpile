---
const currentYear = 2026;
---

<footer class="bg-white border-t border-mechline-border text-mechline-gray text-xs">
  
  <!-- Top Query Hotline Strip -->
  <div class="border-b border-mechline-border bg-neutral-50 py-3.5 px-4">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-neutral-200 text-center text-xs">
      <div class="py-1 px-3">
        <span class="text-neutral-400 block text-[10px] uppercase font-bold tracking-wider">SIMULASI VOLUME</span>
        <a href="#kalkulator" class="font-bold text-mechline-dark hover:text-mechline-blue">Hitung Kebutuhan Tiang →</a>
      </div>
      <div class="py-1 px-3">
        <span class="text-neutral-400 block text-[10px] uppercase font-bold tracking-wider">WHATSAPP RESMI</span>
        <a href="https://wa.me/6285183005070" target="_blank" rel="noopener noreferrer" class="font-bold text-emerald-600 hover:underline">
          0851-8300-5070
        </a>
      </div>
      <div class="py-1 px-3">
        <span class="text-neutral-400 block text-[10px] uppercase font-bold tracking-wider">WILAYAH OPERASIONAL</span>
        <span class="font-bold text-mechline-dark">Khusus Wilayah Malang</span>
      </div>
      <div class="py-1 px-3">
        <span class="text-neutral-400 block text-[10px] uppercase font-bold tracking-wider">WORKSHOP PUSAT</span>
        <span class="font-bold text-mechline-dark">Kedungkandang, Malang</span>
      </div>
    </div>
  </div>

  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 mb-12">
      
      <!-- Brand & Profile -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex flex-col group">
          <span class="font-heading text-2xl font-black tracking-widest uppercase text-mechline-dark group-hover:text-mechline-blue transition-colors">
            PONDASI MANDIRI
          </span>
          <span class="text-[9px] tracking-[0.2em] uppercase text-neutral-500 font-semibold">
            PT. KONSTRUKSI PONDASI MANDIRI
          </span>
        </a>

        <p class="text-xs text-neutral-600 leading-relaxed pr-4">
          Kontraktor terpadu spesialis rekayasa pondasi dalam: Bore Pile Hydraulic Rig, Wash Boring Mini Crane, Mini Hydraulic Dry System, Tiang Pancang Tekan HSPD bebas getaran, dan armada truk tangki vacuum sedot lumpur bergaransi resmi khusus wilayah Malang Raya.
        </p>

        <!-- Plain Contact Text -->
        <div class="pt-2 text-xs space-y-1.5 text-neutral-700">
          <p><strong>Workshop & Kantor Pusat:</strong> Puncak Buring Indah, Kel. Buring, Kec. Kedungkandang, Kota Malang</p>
          <p><strong>WhatsApp / Telepon:</strong> <a href="https://wa.me/6285183005070" class="text-emerald-700 font-semibold hover:underline">0851-8300-5070</a> (Setiap Hari, 08:00 – 17:00 WIB)</p>
          <p><strong>Cakupan Layanan:</strong> Khusus Wilayah Malang (Kota Malang, Kab. Malang, & Kota Batu)</p>
        </div>
      </div>

      <!-- 5 Layanan Spesialis -->
      <div class="space-y-3">
        <h4 class="font-bold text-mechline-dark text-xs uppercase tracking-wider">Layanan Spesialis</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="#layanan" class="hover:text-mechline-blue transition-colors">Bore Pile Hydraulic Rig</a></li>
          <li><a href="#layanan" class="hover:text-mechline-blue transition-colors">Wash Boring Mini Crane</a></li>
          <li><a href="#layanan" class="hover:text-mechline-blue transition-colors">Bore Pile Mini Hydraulic</a></li>
          <li><a href="#layanan" class="hover:text-mechline-blue transition-colors">Piling HSPD (Silent Tekan)</a></li>
          <li><a href="#layanan" class="hover:text-mechline-blue transition-colors">Sedot Lumpur Vacuum</a></li>
        </ul>
      </div>

      <!-- Area Jangkauan Operasional Malang -->
      <div class="space-y-3">
        <h4 class="font-bold text-mechline-dark text-xs uppercase tracking-wider">Area Layanan Malang</h4>
        <ul class="space-y-2 text-xs text-neutral-600">
          <li><span>Kedungkandang & Klojen</span></li>
          <li><span>Blimbing & Lowokwaru</span></li>
          <li><span>Sukun & Pakisaji</span></li>
          <li><span>Singosari & Lawang</span></li>
          <li><span>Kepanjen & Wagir</span></li>
          <li><span>Kota Batu & Sekitarnya</span></li>
        </ul>
      </div>

      <!-- Standar Teknis & Legalitas -->
      <div class="space-y-3">
        <h4 class="font-bold text-mechline-dark text-xs uppercase tracking-wider">Standar K3 & Legalitas</h4>
        <ul class="space-y-2 text-xs text-neutral-600">
          <li><span>Standar SNI 8460:2017 Geoteknik</span></li>
          <li><span>Fasilitas Uji PIT & PDA Mandiri</span></li>
          <li><span>Disposal Pembuangan Lumpur Berizin</span></li>
          <li><span>Garansi Opname Meter Riil Lapangan</span></li>
          <li><span>Kontrak Kerja SPK Resmi</span></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-mechline-border flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-[11px] text-neutral-500">
        Copyright © {currentYear}, PT. Konstruksi Pondasi Mandiri. Seluruh hak cipta dilindungi undang-undang.
      </p>

      <div class="flex items-center gap-4 text-[11px] text-neutral-500">
        <span>Hubungi Langsung:</span>
        <a href="https://wa.me/6285183005070" target="_blank" rel="noopener noreferrer" class="font-bold text-emerald-600 hover:underline">
          WhatsApp 0851-8300-5070
        </a>
      </div>
    </div>

  </div>

  <!-- Scroll to Top Button -->
  <button
    id="scroll-to-top"
    type="button"
    class="fixed bottom-6 right-6 z-40 w-10 h-10 rounded-lg bg-mechline-blue hover:bg-mechline-blue-hover text-white shadow-md flex items-center justify-center transition-all opacity-0 pointer-events-none"
    aria-label="Kembali ke atas"
  >
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
    </svg>
  </button>
</footer>

<script>
  const scrollBtn = document.getElementById('scroll-to-top');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 400) {
      scrollBtn?.classList.remove('opacity-0', 'pointer-events-none');
      scrollBtn?.classList.add('opacity-100');
    } else {
      scrollBtn?.classList.add('opacity-0', 'pointer-events-none');
      scrollBtn?.classList.remove('opacity-100');
    }
  });
  scrollBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
